# Supabase — public client configuration only.
# These two values ship to the browser by design (the anon/publishable key is
# not a secret; authorization lives in RLS). Copy to .env.local for local dev.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Never add SUPABASE_SERVICE_ROLE_KEY here or anywhere in this app.
# The application is designed to never need an elevated credential:
# privileged writes go through SECURITY DEFINER database functions.

# --- AI (server-side only; optional — leave unset and the assistive layer hides itself) ---
# The key never ships to the browser and never starts with NEXT_PUBLIC_ (§6, ai.html).
# AI_PROVIDER=openai-compatible   # or: anthropic
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=qwen2.5-vl-7b-instruct
# AI_API_KEY=
# AI_TEMPERATURE=0.3
# AI_MAX_TOKENS=800
